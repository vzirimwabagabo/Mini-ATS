# Supabase Backend Configuration
# 1. Create a project at https://supabase.com
# 2. Run the SQL in supabase/schema.sql in the Supabase SQL Editor
# 3. Copy your project URL and public anon key below:

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# The anon key is public; never put a service-role key or other private key in this file.
# Client-side AI keys are intentionally unsupported; use a trusted server integration.

